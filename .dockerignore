# VCS
.git
.gitignore
.git-blame-ignore-revs

# Local Python state — never bake into the image
.venv
.pytest_cache
.ruff_cache
**/__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
build/
dist/

# Weights are supplied at runtime (bind mount, PVC, or init container).
# Including them would balloon the image and force a rebuild on every weight bump.
models/

# Local scratch and tooling state
NOTES.md
.claude/
.DS_Store

# Docs are not needed in the runtime image
docs/